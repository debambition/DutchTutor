# Copy this file to .env and fill in the values for the providers you use.

# --- LLM provider ---
# One of: mock | azure_openai | openai
LLM_PROVIDER=mock

# Azure OpenAI (used when LLM_PROVIDER=azure_openai)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Speech provider ---
# One of: mock | azure
SPEECH_PROVIDER=mock

# Azure AI Speech (used when SPEECH_PROVIDER=azure)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Resource endpoint (e.g. https://<name>.cognitiveservices.azure.com/). Required
# when the key belongs to an Azure AI Services resource with a custom subdomain.
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_RECOGNITION_LOCALE=nl-NL
AZURE_SPEECH_VOICE=nl-NL-ColetteNeural

# --- App ---
DATA_DIR=./data/users
